{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchFileNames": ["verity/smoke-tests/build.gradle.kts"],
      "enabled": false,
      "matchPackageNames": [
        "io.grpc:grpc{/,}**"
      ]
    },
    {
      "groupName": "gRPC",
      "matchPackageNames": [
        "io.grpc:grpc{/,}**"
      ]
    },
    {
      "groupName": "Maestro",
      "matchPackageNames": [
        "dev.mobile:maestro{/,}**"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
